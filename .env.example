# ==============================================================================
# Discord Music Bot Configuration (Prefix-Only d! Mode + Security Hardening)
# Copy this file to .env and fill in DISCORD_TOKEN (the ONLY required value!)
# ==============================================================================

# [REQUIRED] Your Discord Bot Token from https://discord.com/developers/applications
# IMPORTANT: Enable "Message Content Intent" under Bot -> Privileged Gateway Intents!
DISCORD_TOKEN=your_discord_bot_token_here

# [OPTIONAL] Command prefix (default: d!)
COMMAND_PREFIX=d!

# [OPTIONAL] Automatically remove old slash commands on boot so ONLY d! works (default: true)
CLEAR_SLASH_COMMANDS=true

# ==============================================================================
# Security Controls (all optional; SSRF, mention-guard, rate-limit & queue cap are ALWAYS ON)
# ==============================================================================

# Bot Owner Discord User ID(s), comma-separated (bypass DJ/channel/user locks;
# admin customization commands d!settings / d!nodes / d!security / d!emojis strictly require
# a server role with Administrator or Manage Server permission)
# OWNER_IDS=123456789012345678

# Lock the bot to ONLY your Discord server ID(s), comma-separated (highly recommended!)
# ALLOWED_GUILD_IDS=123456789012345678
# Automatically leave any unauthorized server someone invites the bot to (default: true)
LEAVE_UNAUTHORIZED_GUILDS=true

# Restrict music commands to specific text channel ID(s), comma-separated
# ALLOWED_CHANNEL_IDS=123456789012345678

# Restrict bot usage to specific Discord user ID(s), comma-separated
# ALLOWED_USER_IDS=123456789012345678

# Require DJ role / Admin / alone-in-VC for stop/skip/volume/clear/filter/loop controls (default: false)
REQUIRE_DJ_ROLE=false
DJ_ROLE_NAME=DJ
# DJ_ROLE_IDS=123456789012345678

# Anti-spam & anti-OOM limits
MAX_QUEUE_SIZE=200
USER_COOLDOWN_MS=2000
MAX_COMMANDS_PER_WINDOW=8

# ==============================================================================
# Audio & Hosting Settings
# ==============================================================================

# Custom / Self-Hosted Lavalink v4.2+ Node (leave blank to auto-discover free public nodes!)
# LAVALINK_HOST=lavalink
# LAVALINK_PORT=2333
# LAVALINK_PASSWORD=youshallnotpass
# LAVALINK_SECURE=false
# LAVALINK_NODES=[{"id":"primary","host":"your-host","port":443,"authorization":"your-pass","secure":true}]

AUTO_PUBLIC_NODES=true
DEFAULT_SEARCH_PLATFORM=ytmsearch
IDLE_LEAVE_SECONDS=120
DEFAULT_VOLUME=80
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# HEALTH_PORT=3000
